---
import AcademicCard from "../components/AcademicCard.astro";
import Layout from "../layouts/Layout.astro";
import { education, professionalCertifications, coursesAccreditations } from "../content/data/db";
---

<Layout>
  <section class="py-10">
    <!-- Sección de Educación -->
    <div class="container mx-auto px-6 flex flex-col gap-8 my-5">
      <h2 class="text-2xl font-bold text-primary-white">Educación</h2>
      {
        education.map((item) => (
          <div class="animate-slideUp">
            <AcademicCard
              image={item.image}
              title={item.title}
              subtitle={item.subtitle}
              footText={item.footText}
              href={item.href}
            />
          </div>
        ))
      }
    </div>

    <!-- Sección de Certificaciones Profesionales -->
    <div class="container mx-auto px-6 flex flex-col gap-8 my-5">
      <h2 class="text-2xl font-bold text-primary-white">Certificaciones Profesionales</h2>
      {
        professionalCertifications.map((item) => (
          <div class="animate-slideUp-delayed">
            <AcademicCard
              image={item.image}
              title={item.title}
              subtitle={item.subtitle}
              footText={item.footText}
              href={item.href}
            />
          </div>
        ))
      }
    </div>

    <!-- Sección de Cursos y Acreditaciones -->
    <div class="container mx-auto px-6 flex flex-col gap-8 my-5">
      <h2 class="text-2xl font-bold text-primary-white">Cursos y Acreditaciones</h2>
      {
        coursesAccreditations.map((item) => (
          <div class="animate-slideUp-delayed">
            <AcademicCard
              image={item.image}
              title={item.title}
              subtitle={item.subtitle}
              footText={item.footText}
              href={item.href}
            />
          </div>
        ))
      }
    </div>
  </section>
</Layout>
