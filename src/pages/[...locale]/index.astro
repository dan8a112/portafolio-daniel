---
import Layout from "../../layouts/Layout.astro";
import { getHome, getProjects } from "../../lib/content";
import SectionRenderer from "../../components/blocks/SectionRenderer.astro";

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }]
}

const locale = Astro.params.locale as 'es' | 'en'
const [home, projects] = await Promise.all([
  getHome(locale),
  getProjects(locale),
])

// TODO(rediseño): temporal — solo se renderiza el hero mientras se rediseña el home.
const visibleSections = home.sections.filter((section) => section.type === 'hero')
---

<Layout>
  <SectionRenderer
    sections={visibleSections}
    featuredProjects={projects}
  />
</Layout>
