---
import Layout from "../../layouts/Layout.astro";
import { getExperiences, getHome, getProjects, getSkillCategories } from "../../lib/content";
import SectionRenderer from "../../components/blocks/SectionRenderer.astro";

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }]
}

const locale = Astro.params.locale as 'es' | 'en'
const [home, projects, experiences, skillCategories] = await Promise.all([
  getHome(locale),
  getProjects(locale),
  getExperiences(locale),
  getSkillCategories(locale),
])

// TODO(rediseño): temporal — se renderizan hero, highlights, experience, featuredProjects y skills mientras se rediseña el home.
const visibleSections = home.sections.filter(
  (section) =>
    section.type === 'hero' ||
    section.type === 'highlights' ||
    section.type === 'experience' ||
    section.type === 'featuredProjects' ||
    section.type === 'skills'
)
---

<Layout>
  <SectionRenderer
    sections={visibleSections}
    featuredProjects={projects}
    experiences={experiences}
    skillCategories={skillCategories}
  />
</Layout>
