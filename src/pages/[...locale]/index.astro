---
import Layout from "../../layouts/Layout.astro";
import { getAcademic, getExperiences, getHome, getProjects, getSite, getSkillCategories } from "../../lib/content";
import SectionRenderer from "../../components/blocks/SectionRenderer.astro";

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'en' } }]
}

const locale = Astro.params.locale as 'es' | 'en'
const [home, projects, experiences, skillCategories, academic, site] = await Promise.all([
  getHome(locale),
  getProjects(locale),
  getExperiences(locale),
  getSkillCategories(locale),
  getAcademic(locale),
  getSite(locale),
])

// TODO(rediseño): temporal — se renderizan hero, highlights, about, experience, featuredProjects, skills, education y contact mientras se rediseña el home.
const visibleSections = home.sections.filter(
  (section) =>
    section.type === 'hero' ||
    section.type === 'highlights' ||
    section.type === 'about' ||
    section.type === 'experience' ||
    section.type === 'featuredProjects' ||
    section.type === 'skills' ||
    section.type === 'education' ||
    section.type === 'contact'
)
---

<Layout>
  <SectionRenderer
    sections={visibleSections}
    featuredProjects={projects}
    experiences={experiences}
    skillCategories={skillCategories}
    academic={academic}
    site={site}
  />
</Layout>
