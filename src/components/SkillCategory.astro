---
import type { Skills } from "../interfaces/interface";

interface Props {
  title: string;
  skills: Skills;
}

const { title, skills } = Astro.props as Props;

const icons: Record<string, string> = {
  "Datos y BI": `<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>`,
  "Lenguajes de Programación": `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  "Frontend": `<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>`,
  "Backend": `<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>`,
  "DevOps y Herramientas": `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  "Diseño": `<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>`,
  "Idiomas": `<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>`
};
---

<section>
    <div class="container mx-auto px-6 flex flex-col">
      <!-- Título principal -->
      <h2 class="text-3xl font-bold text-primary-white mb-6">{title}</h2>
  
      <!-- Lista de categorías (en fila) -->
      <div class="flex flex-col md:flex-row flex-wrap gap-8 animate-slideUp">
        {
          Object.entries(skills).map(([cat, skl]) => (
            <div class="bg-tertiary-lightblue p-6 rounded-lg shadow-md min-w-[350px] max-w-[400px]">
              <!-- Título de la categoría con ícono -->
              <div class="flex items-center gap-2 mb-4">
                <span
                  class="text-secondary-yellow shrink-0"
                  set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[cat] ?? ""}</svg>`}
                />
                <p class="text-xl font-semibold text-primary-white">{cat}</p>
              </div>
  
              <!-- Badges de skills -->
              <div class="flex flex-wrap gap-2">
                {
                  skl.map((skill) => (
                    <span class="bg-background-blue text-primary-white text-sm px-3 py-1 rounded-full">
                      {skill.text}
                    </span>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>