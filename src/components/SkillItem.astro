---
import { Image } from "astro:assets";
import type { SkillItem } from "../types/domain";
import { getLocaleFromUrl, useTranslations } from "../lib/i18n";
const { icon, text, percentage, endText } = Astro.props as SkillItem;
const locale = getLocaleFromUrl(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="bg-surface p-4 rounded-lg shadow-md">
  <!-- Contenido superior: Ícono, texto y porcentaje -->
  <div class="flex justify-between items-center mb-4">
    <div class="flex items-center space-x-4">
      <!-- Ícono -->
      {
        icon && (
          <Image src={icon} alt={t('skills.iconAlt')} width={40} height={40} />
        )
      }
      <!-- Texto -->
      <span class="text-lg text-white">{text}</span>
    </div>
    <!-- Porcentaje -->
    <span class="text-lg text-white">{endText}</span>
  </div>

  <!-- Barra de progreso -->
  <div class="w-full bg-border rounded-full h-2">
    <div
      class="bg-primary h-2 rounded-full transition-all duration-1000"
      style={`width: ${percentage * 100}%;`}
    >
    </div>
  </div>
</div>
