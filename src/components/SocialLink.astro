---
import type { Site } from "../types/domain";

interface Props {
  social: Site['socials'][number];
}

const { social } = Astro.props;
---

<a href={social.url} class="inline-block">
  <img
    src={social.icon}
    alt={social.altText}
    width="45"
    height="45"
    class="rounded-lg shadow-lg transform transition-all duration-300 hover:scale-95 hover:opacity-80"
  />
</a>
