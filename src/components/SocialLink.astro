---
import type { Site } from "../types/domain";

interface Props {
  social: Site['socials'][number];
}

const { social } = Astro.props;
---

<a
  href={social.url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex h-11 w-11 items-center justify-center rounded-xl border border-border text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-primary hover:bg-primary/10"
>
  <img
    src={social.icon}
    alt={social.altText}
    width="20"
    height="20"
    class="brightness-0 invert"
  />
</a>
