---
import { Image } from "astro:assets";
import type { AcademicEntry } from "../types/domain";
import { getLocaleFromUrl, useTranslations } from "../lib/i18n";
const {image, title, subtitle, period, href} = Astro.props as AcademicEntry;
const locale = getLocaleFromUrl(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="bg-surface p-4 rounded-lg shadow-md md:w-[80%] w-[100%]">
    <div class="flex items-center">
        {
          href ? (
            <a href={href} target="_blank" rel="noopener noreferrer">
              <Image class="mr-4 rounded-md" src={image} alt={t('education.imageAlt')} width={100} height={100}></Image>
            </a>
          ) : (
            <Image class="mr-4 rounded-md" src={image} alt={t('education.imageAlt')} width={100} height={100}></Image>
          )
        }
        <div class="flex flex-col gap-1">
            <p class="text-lg font-bold text-white">{title}</p>
            <p class="text-md font-semibold text-white">{subtitle}</p>
            <p class="text-neutral">{period}</p>
        </div>
    </div>
</div>