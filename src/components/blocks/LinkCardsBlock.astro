---
import type { Section } from "../../types/domain";
import LinkCard from "../LinkCard.astro";
import { getLocaleFromUrl, localizePath } from "../../lib/i18n/utils";

interface Props {
  section: Extract<Section, { type: 'linkCards' }>;
}

const { section } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
---

<section class="container mx-auto px-6 pb-6 pt-5">
  <h2 class="text-3xl mb-6 text-white">{section.title}</h2>
  <div class="flex flex-col md:flex-row gap-6">
    {section.links.map((link) => (
      <LinkCard text={link.label} href={localizePath(link.href, locale)} />
    ))}
  </div>
</section>
