---
import { Image } from "astro:assets";
import type { AcademicEntry, Section } from "../../types/domain";
import { getLocaleFromUrl, localizePath, useTranslations } from "../../lib/i18n";

interface Props {
  section: Extract<Section, { type: 'education' }>;
  academic: AcademicEntry[];
}

const { section, academic } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const t = useTranslations(locale);
const education = academic
  .filter((entry) => entry.kind === 'education')
  .sort((a, b) => a.order - b.order);
const certificates = academic
  .filter((entry) => entry.kind !== 'education')
  .sort((a, b) => a.order - b.order);
const [featuredCertificate, secondaryCertificate] = certificates;
---

<section class="container mx-auto px-6 py-16">
  <h2 class="mb-10 text-3xl font-bold text-white">{section.title}</h2>

  <div class="grid gap-10 lg:grid-cols-2">
    <div>
      <h3 class="mb-5 text-xl font-semibold text-white">{section.educationTitle}</h3>
      <div class="space-y-4">
        {education.map((entry) => (
          <article class="flex items-center gap-5 rounded-xl border border-border bg-surface p-5 shadow-md">
            <Image
              src={entry.image}
              alt={entry.title}
              width={96}
              height={96}
              class="h-20 w-20 shrink-0 rounded-lg object-cover"
            />
            <div>
              <h4 class="font-semibold text-white">{entry.title}</h4>
              <p class="mt-1 text-sm text-primary">{entry.subtitle}</p>
              <p class="mt-2 text-sm text-neutral">{entry.period}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div>
      <h3 class="mb-5 text-xl font-semibold text-white">{section.certificatesTitle}</h3>
      {featuredCertificate && (
        <article class="rounded-xl border border-primary/50 bg-surface p-6 shadow-md">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
            <Image
              src={featuredCertificate.image}
              alt={featuredCertificate.title}
              width={200}
              height={140}
              class="h-32 w-full rounded-lg object-cover sm:w-44"
            />
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary">
                {section.certificatesTitle}
              </p>
              <h4 class="text-xl font-bold text-white">{featuredCertificate.title}</h4>
              <p class="mt-2 text-sm font-medium text-primary">{featuredCertificate.subtitle}</p>
              <p class="mt-3 text-sm text-neutral">{featuredCertificate.period}</p>
            </div>
          </div>
        </article>
      )}

      {secondaryCertificate && (
        <article class="mt-4 flex items-center gap-4 rounded-xl border border-border bg-surface p-4">
          <Image
            src={secondaryCertificate.image}
            alt={secondaryCertificate.title}
            width={72}
            height={72}
            class="h-16 w-16 shrink-0 rounded-lg object-cover"
          />
          <div>
            <h4 class="font-semibold text-white">{secondaryCertificate.title}</h4>
            <p class="mt-1 text-sm text-primary">{secondaryCertificate.subtitle}</p>
            <p class="mt-2 text-sm text-neutral">{secondaryCertificate.period}</p>
          </div>
        </article>
      )}
    </div>
  </div>

  <div class="mt-10 flex justify-end">
    <a
      href={localizePath('/education', locale)}
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white transition-colors hover:text-primary"
    >
      {t('education.exploreAll')}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
