---
import type { Section, Site } from "../../types/domain";
import { getLocaleFromUrl, useTranslations } from "../../lib/i18n";

interface Props {
  section: Extract<Section, { type: 'contact' }>;
  site: Site;
}

const { section, site } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const t = useTranslations(locale);
const emailUrl = site.socials.find((social) => social.url.startsWith('mailto:'))?.url;
---

<section class="bg-surface">
  <div class="container mx-auto px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-2">
    <div>
      <h2 class="mb-6 text-3xl font-bold text-white">{section.title}</h2>
      <div class="space-y-5">
        {section.paragraphs.map((paragraph) => (
          <p class="contact-paragraph leading-relaxed text-neutral" set:html={paragraph}></p>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {site.socials.map((social) => (
          <a
            href={social.url}
            target={social.url.startsWith('http') ? '_blank' : undefined}
            rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="inline-flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 text-sm font-medium text-white transition-colors hover:border-primary hover:text-primary"
          >
            <img src={social.icon} alt="" width="20" height="20" class="brightness-0 invert" />
            {social.altText}
          </a>
        ))}
      </div>
    </div>

    <form action={emailUrl} method="post" enctype="text/plain">
      <div class="mb-5">
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          aria-label={t('contact.name')}
          class="w-full border-b border-border bg-transparent py-2 text-white outline-none transition-colors placeholder:font-medium placeholder:text-white focus:border-primary"
          placeholder={t('contact.name')}
        />
      </div>

      <div class="mb-5">
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          aria-label={t('contact.email')}
          class="w-full border-b border-border bg-transparent py-2 text-white outline-none transition-colors placeholder:font-medium placeholder:text-white focus:border-primary"
          placeholder={t('contact.email')}
        />
      </div>

      <div class="mb-6">
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          aria-label={t('contact.message')}
          class="w-full resize-y border-b border-border bg-transparent py-2 text-white outline-none transition-colors placeholder:font-medium placeholder:text-white focus:border-primary"
          placeholder={t('contact.message')}
        ></textarea>
      </div>

      <div class="flex justify-end">
        <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90">
          {t('contact.submit')}
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </form>
    </div>
  </div>
</section>
