---
import type { Experience, Project, Section, SkillCategory } from "../../types/domain";
import HeroBlock from "./HeroBlock.astro";
import ContentSectionBlock from "./ContentSectionBlock.astro";
import LinkCardsBlock from "./LinkCardsBlock.astro";
import FeaturedProjectsBlock from "./FeaturedProjectsBlock.astro";
import HighlightsBlock from "./HighlightsBlock.astro";
import ExperienceBlock from "./ExperienceBlock.astro";
import SkillsBlock from "./SkillsBlock.astro";

interface Props {
  sections: Section[];
  featuredProjects?: Project[];
  experiences?: Experience[];
  skillCategories?: SkillCategory[];
}

const { sections, featuredProjects = [], experiences = [], skillCategories = [] } = Astro.props;
---

{
  sections.map((section) => {
    switch (section.type) {
      case 'hero':
        return <HeroBlock section={section} />;
      case 'content':
        return <ContentSectionBlock section={section} />;
      case 'linkCards':
        return <LinkCardsBlock section={section} />;
      case 'featuredProjects':
        return <FeaturedProjectsBlock section={section} projects={featuredProjects} />;
      case 'highlights':
        return <HighlightsBlock section={section} />;
      case 'experience':
        return <ExperienceBlock section={section} experiences={experiences} />;
      case 'skills':
        return <SkillsBlock section={section} categories={skillCategories} />;
      default:
        return null;
    }
  })
}
