---
import { Image } from "astro:assets";
import type { Project } from "../types/domain";
import { getLocaleFromUrl, localizePath, useTranslations } from "../lib/i18n";
const {image, title, description, skills, href} = Astro.props as Project & { href: string };
const locale = getLocaleFromUrl(Astro.url.pathname);
const localizedHref = localizePath(href, locale);
const t = useTranslations(locale);
---

<div class="bg-surface p-6 shadow-md rounded-xl animate-fadeInLeft">
    <div class="flex flex-col md:flex-row items-center gap-5">
        <!--Imagen -->
        <Image 
        src={image}
        alt={t('project.imageAlt')}
        width={200}
        height={200}
        class="rounded-lg shadow-lg"/>

        <div class="flex flex-col">
            <h2 class="text-2xl text-primary mb-2">{title}</h2>
            <p class="text-md text-white mb-3">{description}</p>
            <div class="flex items-center gap-3 flex-wrap mb-5">
                {skills.map(skill=> (<div class="px-3 py-1 rounded-2xl border border-white text-white">{skill}</div>))}
            </div>
            <div class="flex justify-end">
                <a href={localizedHref}>
                    <div class="px-4 py-2 border-none bg-primary rounded-xl text-white">{t('project.seeMore')}</div>
                </a>
            </div>
        </div>
    </div>
</div>