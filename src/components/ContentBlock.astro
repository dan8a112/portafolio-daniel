---
import { Image } from "astro:assets";
import type { ContentBlock } from "../types/domain";
const {title, paragraph, image, imageAlt, imageRight} = Astro.props as ContentBlock

const splitedTitle = title.split(" ");
---

<section class="py-8 animate-slideUp-delayed">
    <div class={`container mx-auto px-6 flex flex-col ${imageRight ? 'md:flex-row-reverse' : 'md:flex-row'} gap-8`}>
      <!-- Contenido de texto -->
      <div class="md:w-1/2 space-y-4">
        <h2 class="text-3xl font-semibold">
            {splitedTitle.map((tlt, index)=>
                <span class={`${index===0 ? "text-white" : "text-primary"} mr-1`}>
                    {tlt}
                </span>)}
        </h2>
        <p class="text-white text-lg" set:html={paragraph}></p>
      </div>
  
      <!-- Imagen -->
      <div class="md:w-1/2 flex justify-center">
        <Image
          src={image}
          width={300}
          height={300}
          alt={imageAlt}
        />
      </div>
    </div>
  </section>